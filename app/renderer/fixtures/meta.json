{
  "harnesses": [
    "claude-cli",
    "opencode"
  ],
  "models": [
    {
      "alias": "haiku",
      "label": "Haiku (barato/rápido)",
      "tier": "cheap"
    },
    {
      "alias": "sonnet",
      "label": "Sonnet (equilibrado)",
      "tier": "mid"
    },
    {
      "alias": "opus",
      "label": "Opus (potente)",
      "tier": "high"
    },
    {
      "alias": "fable",
      "label": "Fable (máximo)",
      "tier": "max"
    }
  ],
  "permission_modes": [
