{
  "name": "faros",
  "version": "3.3.50",
  "description": "FarOS — a ticket board where agents propose, execute and verify each other's work",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --config electron-builder.yml",
    "dist:dir": "electron-builder --win --dir --config electron-builder.yml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "author": "josortmel"
}
